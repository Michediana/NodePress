---
{
  "label": "Griglia di articoli",
  "description": "Gli ultimi elementi di un raccoglitore.",
  "settings": {
    "title": { "type": "text", "label": "Titolo" },
    "items": { "type": "items", "label": "Elementi", "default": { "collection": "/novita", "limit": 3 } },
    "columns": {
      "type": "select",
      "label": "Colonne",
      "default": "3",
      "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }]
    },
    "moreLabel": { "type": "text", "label": "Testo del link finale" },
    "moreUrl": { "type": "link", "label": "Link finale" }
  }
}
---
{settings.items.length > 0 && (
  <section class="post-grid">
    {settings.title && <h2 class="post-grid__title">{settings.title}</h2>}
    <div class="post-grid__items" data-columns={settings.columns}>
      {settings.items.map(item => <PostCard item={item} />)}
    </div>
    {settings.moreLabel && settings.moreUrl && (
      <Link to={settings.moreUrl} class="post-grid__more">{settings.moreLabel} →</Link>
    )}
  </section>
)}

<style>
  .post-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding-block: 3rem;
  }
  .post-grid__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .post-grid__items {
    display: grid;
    gap: 2rem;
    @media (min-width: 640px) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    &[data-columns="3"] {
      @media (min-width: 1024px) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }
  }
  .post-grid__more {
    align-self: flex-start;
    font-weight: 500;
    text-underline-offset: 4px;
  }
</style>
