# Connessione MySQL/MariaDB
DATABASE_URL=mysql://root@127.0.0.1:3306/nodepress
# Segreto per firmare i cookie di sessione (stringa lunga e casuale)
SESSION_SECRET=change-me
# Cartella dove vengono salvati i media caricati
MEDIA_DIR=./storage/media
# Origine separata per il pannello (facoltativa), es. https://admin.esempio.it.
# Con questa impostata, imposta anche l'URL pubblico del sito in Impostazioni → Generali.
# ADMIN_URL=
